library(tidyverse)
library(sdodemog)
UPDATE <- FALSE
VINTAGE <- 2024
VSTR <- str_c("V", str_sub(VINTAGE, 3, 4))
base_folder <- "G:/Shared drives/State Demography Office/Projections/" %>%
str_c("Vintage 2024/Scenario Data/Raw")
if(UPDATE){
scenario_pop_df <- bind_rows(
pull_updated_county_sya() %>%
mutate(model = "V24") %>%
mutate(model = if_else(year >= 2025, "V24forecast", "V24estimate")),
pull_updated_county_sya(model = "V24intmigonly") %>%
mutate(model = "V24lowmigration") %>%
filter(year >= 2025),
pull_updated_county_sya(model = "V24newnetzero") %>%
mutate(model = "V24netzero") %>%
filter(year >= 2025),
pull_updated_county_sya(model = "V24verylowfert") %>%
mutate(model = "V24verylowfertility") %>%
filter(year >= 2025),
pull_updated_county_sya(model = "V24lowfert") %>%
mutate(model = "V24lowfertility") %>%
filter(year >= 2025)) %>%
mutate(GEOID = sprintf("08%03d", countyfips)) %>%
left_join(pull_county_fips()) %>%
select(-GEOID) %>%
rename(county = NAME)
scenario_pop_df
for(m in unique(scenario_pop_df$model)){
scenario_pop_df %>%
filter(model == m) %>%
write_csv(str_c(base_folder, m, ".csv"))
}
}
model_files <- list.files(base_folder, full.names = TRUE, pattern = VSTR)
age_summaries <- list(
"Total" = c(0, 125),
"School5_17" = c(5, 17),
"College18_24" = c(18, 24),
"WorkAge25_54" = c(25, 54),
"Retire65p" = c(65, 125),
"OldAge80p" = c(80, 125)
)
model_df <- read_csv(model_files) %>%
mutate(model = if_else(model == str_c(VSTR, "estimate"), VSTR, model)) %>%
mutate(model = if_else(model == str_c(VSTR, "forecast"), VSTR, model))
out_df <- bind_rows(lapply(1:length(age_summaries), function(i){
lwr <- min(age_summaries[[i]])
upr <- max(age_summaries[[i]])
group <- names(age_summaries)[i]
model_df %>%
filter(age >= lwr, age <= upr) %>%
group_by(model, year, datatype) %>%
summarize(pop = sum(totalpopulation), .groups = "drop") %>%
mutate(group = group)}
)) %>%
pivot_wider(names_from = group, values_from = pop) %>%
mutate(countyfips = 0)
model_files
model_df
model_df %>% filter(countyfips ==0)
tpop_plot <- model_df %>%
group_by(year, model) %>%
summarize(pop = sum(totalpopulation), .groups = "drop") %>%
mutate(model = case_when(
model == VSTR & year > VINTAGE ~ "Forecast",
model == VSTR ~ "Estimate",
model == "V24verylowfertility" ~ "Very Low Fertility",
model == "V24lowfertility" ~ "Low Fertility",
model == "V24netzero" ~ "Zero Migration",
model == "V24lowmigration" ~ "Low Migration"
)) %>%
ggplot(aes(x = year, y = pop, color = model)) +
geom_line(linewidth = 2.5) +
theme_sdo_bare(base_size = 24) +
guides(size = "none") +
theme(axis.text.x = element_text(angle = 45, vjust = 1.3, hjust=1.1)) +
guides(color = "none") +
scale_color_sdo_discrete() +
scale_y_continuous(labels = comma) +
labs(x = NULL, y = NULL, color = NULL)
