mutate(`Diff StateM` = sum_moe(c(NativeM, `Same StateM`))) %>%
select(-NativeE, -NativeM, -GEOID) %>%
pivot_longer(-NAME) %>%
mutate(Type = str_sub(name, -1, -1)) %>%
mutate(name = str_sub(name, 1, -2)) %>%
pivot_wider(values_from = value, names_from = Type) %>%
rename(estimate = E, moe = M, STATE = NAME) %>%
mutate(YEAR = y)}) %>%
bind_rows()
